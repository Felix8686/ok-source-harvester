OSH_ENVIRONMENT=development
OSH_DATABASE_URL=sqlite:///data/harvester.db
OSH_LOG_LEVEL=INFO
OSH_USER_AGENT=ok-source-harvester/0.1
# Optional but strongly recommended. Authenticated GitHub code search gives much better coverage.
OSH_GITHUB_TOKEN=
OSH_COLLECTOR__CONCURRENCY=8
OSH_COLLECTOR__REQUEST_TIMEOUT_SECONDS=15
OSH_GITHUB__CODE_SEARCH_ENABLED=true
OSH_GITHUB__PER_PAGE=30
OSH_GITHUB__MAX_PAGES=2
OSH_GITHUB__MAX_REPOSITORIES_PER_QUERY=20
OSH_GITHUB__MAX_FILES_PER_REPOSITORY=12
OSH_GITHUB__RATE_LIMIT_RESERVE=5
OSH_VALIDATOR__REQUEST_TIMEOUT_SECONDS=12
OSH_VALIDATOR__MAX_RETRIES=2
